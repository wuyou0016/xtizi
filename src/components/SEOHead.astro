---
import { siteConfig } from '../config/site';
import {
  BRAND_TITLE_SUFFIX,
  CANONICAL_HOST,
  DEFAULT_ROBOTS,
  TWITTER_CARD_TYPE,
  defaultOpenGraph,
  ogImageFor,
  resolveCanonicalUrl,
  robotsToString,
  type RobotsDirective,
} from '../config/seo';

interface Props {
  title: string;
  description?: string;
  pathname: string;
  robots?: RobotsDirective;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
}

const {
  title,
  description = siteConfig.defaultDescription,
  pathname,
  robots = DEFAULT_ROBOTS,
  ogType = defaultOpenGraph.type,
  ogImage,
  publishedTime,
  modifiedTime,
  keywords,
} = Astro.props;

// title 若已包含品牌名则不重复拼接，避免"梯子IT实验室｜XXX｜梯子IT实验室"。
const resolvedTitle = title.includes(siteConfig.brandName) ? title : `${title}${BRAND_TITLE_SUFFIX}`;

const canonicalUrl = resolveCanonicalUrl(pathname);
const resolvedOgImage = ogImage ?? ogImageFor(pathname);
const absoluteOgImage = resolvedOgImage.startsWith('http') ? resolvedOgImage : `${CANONICAL_HOST}${resolvedOgImage}`;
const imageAlt = `${resolvedTitle.split('｜')[0]}：${siteConfig.brandName}分享图`;
const sectionName = ogType === 'article' ? (keywords?.[0] ?? undefined) : undefined;
const robotsContent = robotsToString(robots);
---

<title>{resolvedTitle}</title>
<meta name="description" content={description} />
{/* meta keywords 已停用：Bing 不把它作为排名依据，堆词时还可能被当作垃圾信号；keywords 属性保留，用于 article:tag 等。 */}
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robotsContent} />
<meta name="author" content={siteConfig.author.name} />
<meta name="format-detection" content="telephone=no" />
<meta name="google-site-verification" content="VqXegwI0FnvCQK3pmBBVaYgpkaSQYbLkjSMbMPCm4mY" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<meta property="og:title" content={resolvedTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={defaultOpenGraph.siteName} />
<meta property="og:locale" content={defaultOpenGraph.locale} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content={TWITTER_CARD_TYPE} />
<meta name="twitter:title" content={resolvedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && <meta property="article:author" content={siteConfig.author.name} />}
{ogType === 'article' && keywords?.slice(0, 5).map((tag) => <meta property="article:tag" content={tag} />)}
