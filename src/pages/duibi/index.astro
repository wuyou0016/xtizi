---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { getBoard } from '../../data/utils/board';
import { PAIR_COUNT_TOP, pairSlug } from '../../data/utils/compare';
import { bestPerGb, cheapestMonthly, cheapestMonthlyBilled, cleanList, completeness, largestPlan } from '../../data/utils/provider-facts';

const board = await getBoard();
const top = board.rows.slice(0, PAIR_COUNT_TOP);
const pairCount = (top.length * (top.length - 1)) / 2;
const link = (i: number, j: number) => {
  const [x, y] = i < j ? [top[i]!, top[j]!] : [top[j]!, top[i]!];
  return `/duibi/${pairSlug(x.provider.data.slug, y.provider.data.slug)}/`;
};
const faqs = [
  { q: '机场对比主要比哪些项目？', a: '比资料上能查到的项目：最低月均价、付费周期、有没有月付、最大一档流量、每 GB 折算价、线路类型、协议、节点地区和客户端支持。速度、延迟和稳定性没有可靠数据，不在对比范围内，页面上统一标注为“实时检测中”。' },
  { q: `为什么只有前 ${PAIR_COUNT_TOP} 名之间有两两对比页？`, a: '因为对比需要双方都有足够的资料。排名靠后的品牌很多栏位是空白的，放进对比表里只会得到一排“资料暂缺”。它们的现有资料可以在机场大全里各自的页面查看，本页的总表也列出了全部品牌的关键字段。' },
  { q: '两家机场价格差不多时，应该看什么？', a: '依次看三项：付费周期，能月付的退出成本更低；每月流量，折成每 GB 价格更容易比较；线路记录，写明专线并且来源可靠的更有参考价值。如果仍然难以取舍，各买一个最短周期实际对比是最可靠的办法。' },
  { q: '对比结果能告诉我哪家更快吗？', a: '不能。选梯子没有任何一家的测速数据。线路表现取决于你的地区、运营商和使用时段，同一家机场在不同人那里的体验可能完全不同，所以对比页只列事实，不给速度结论。' },
  { q: '我想比的两家不在列表里怎么办？', a: '可以用下面的总表，把两家的行放在一起看：价格、流量、月付、线路、完整度都在同一张表里，并且可以按列排序。也可以分别打开两家的资料页逐项对照。' },
];
---

<BaseLayout
  title="机场对比｜梯子机场两两对比：价格、流量、线路哪个更合适"
  description={`机场对比：选梯子提供推荐榜前 ${top.length} 名之间的 ${pairCount} 组两两对比，逐项比较最低月均价、月付套餐、最大流量、每 GB 折算价、线路、协议与节点地区，并附全部 ${board.rows.length} 家机场的对比总表，可按列排序；另讲清怎样统一口径、不被单个数字带偏。`}
  keywords={['机场对比', '梯子对比', '机场哪个好', '机场比较', '机场横评', '梯子哪个好']}
>
  <Breadcrumbs items={[{ name: '机场对比', href: '/duibi/' }]} />
  <header class="page-head">
    <span class="section__eyebrow">DUIBI / 机场对比</span>
    <h1>机场对比：把两家梯子机场放进同一张表</h1>
    <p class="lead">
      候选缩到两三家以后，最有效的办法是逐项对照。这里提供推荐榜前 {top.length} 名之间的 {pairCount} 组两两对比，以及一张包含全部 {board.rows.length} 家的总表。只比资料里查得到的字段。
    </p>
  </header>

  <section>
    <h2 id="juzhen">两两对比入口（前 {top.length} 名）</h2>
    <p class="muted">行和列交叉的格子就是这两家的对比页。</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th></th>
            {top.map((row) => <th>{row.provider.data.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            top.map((row, i) => (
              <tr>
                <th scope="row" style="white-space:nowrap">{row.provider.data.name}</th>
                {top.map((_, j) => (i === j ? <td class="muted">—</td> : <td><a href={link(i, j)}>对比</a></td>))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section section--tight">
    <h2 id="remen">常被拿来比较的组合</h2>
    <div class="mini-grid">
      {
        top.slice(0, 5).flatMap((x, i) =>
          top.slice(i + 1, 6).map((y) => (
            <a class="mini" href={`/duibi/${pairSlug(x.provider.data.slug, y.provider.data.slug)}/`}>
              <span class="mini__top">{x.provider.data.name} vs {y.provider.data.name}</span>
              <span class="mini__meta">第 {x.rank} 名 对 第 {y.rank} 名</span>
            </a>
          )),
        )
      }
    </div>
  </section>

  <section class="section section--tight">
    <h2 id="zongbiao">全部 {board.rows.length} 家机场对比总表</h2>
    <p class="muted">点击带箭头的表头排序，把想比的几家排到一起看。</p>
    <div class="table-wrap">
      <table data-sortable>
        <thead>
          <tr>
            <th class="num" data-sort>名次</th>
            <th>机场</th>
            <th class="num" data-sort>最低月均价</th>
            <th class="num" data-sort>最低月付价</th>
            <th class="num" data-sort>最大流量</th>
            <th class="num" data-sort>每 GB 折算</th>
            <th>线路</th>
            <th>节点地区</th>
            <th class="num" data-sort>完整度</th>
          </tr>
        </thead>
        <tbody>
          {
            board.rows.map((row) => {
              const cheap = cheapestMonthly(row.provider);
              const monthly = cheapestMonthlyBilled(row.provider);
              const large = largestPlan(row.provider);
              const perGb = bestPerGb(row.provider);
              const routes = cleanList(row.provider.data.vendor.routes);
              const comp = completeness(row.provider).have.length;
              return (
                <tr class:list={[{ 'is-first': row.rank === 1 }]}>
                  <td class="num" data-v={row.rank}>{row.rank}</td>
                  <td><a href={`/jichang/${row.provider.data.slug}/`}>{row.provider.data.name}</a></td>
                  <td class="num" data-v={cheap?.monthly ?? ''}>{cheap ? `¥${cheap.monthly}` : '—'}</td>
                  <td class="num" data-v={monthly?.monthly ?? ''}>{monthly ? `¥${monthly.monthly}` : '—'}</td>
                  <td class="num" data-v={large?.gb ?? ''}>{large ? `${large.gb}GB` : '—'}</td>
                  <td class="num" data-v={perGb?.perGb ?? ''}>{perGb ? `¥${perGb.perGb.toFixed(3)}` : '—'}</td>
                  <td>{routes.join('、') || '—'}</td>
                  <td>{(row.provider.data.vendor.regions ?? []).join('、') || '—'}</td>
                  <td class="num" data-v={comp}>{comp}/5</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="table-note">“—”表示资料暂缺。最低月付价只统计资料里标明按月付费的套餐。</p>
  </section>

  <section class="section section--tight prose" style="max-width:52rem">
    <h2>机场怎么对比才不被数字带偏</h2>
    <h3>先统一口径</h3>
    <p>把所有价格折成月均价，把流量统一成每月多少 GB，再算每 GB 折算价。年付和月付要分开看，因为它们的风险不一样。可以用<a href="/gongju/chengben-jisuanqi/">成本计算器</a>自己折算。</p>
    <h3>再看不能量化的项</h3>
    <p>线路类型、节点地区、客户端支持没法折成一个数字，但它们决定了套餐适不适合你的用法。要用对地区有要求的服务，节点地区比价格更重要；晚高峰用得多，线路类型比流量更重要。</p>
    <h3>最后承认资料的局限</h3>
    <p>资料只能告诉你“买到的是什么”，不能告诉你“用起来怎么样”。把候选缩到两家之后，各买最短周期实测，是任何对比表都替代不了的一步。相关方法见<a href="/zhinan/tizi-zenme-xuan/">梯子怎么选</a>和<a href="/zhinan/jichang-shiyong/">机场试用怎么找</a>。</p>
  </section>

  <FaqBlock heading="机场对比常见问题" items={faqs} />
</BaseLayout>
