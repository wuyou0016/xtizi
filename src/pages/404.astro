---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在（404）" description="你访问的页面不存在或已经移动。可以从选梯子首页、机场推荐榜、梯子下载或梯子导航重新开始查找需要的内容。" robots={{ index: false, follow: true }}>
  <div class="empty-state" style="margin-top:3rem">
    <p class="section__eyebrow">404 / NOT FOUND</p>
    <h1>这一级台阶不存在</h1>
    <p>页面可能已经移动，或者地址输入有误。从下面几个入口重新出发：</p>
    <p class="btn-row" style="justify-content:center">
      <a class="btn" href="/">回到首页</a>
      <a class="btn btn--ghost" href="/tuijian/">机场推荐榜</a>
      <a class="btn btn--ghost" href="/xiazai/">梯子下载</a>
      <a class="btn btn--ghost" href="/daohang/">梯子导航</a>
    </p>
  </div>
</BaseLayout>
